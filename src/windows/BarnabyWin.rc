#include "src/windows/resource.h"

#define VS_FFI_FILEFLAGSMASK 0x0000003fL
#define VS_FF_DEBUG 0x00000001L
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L

IDI_BARNABY_APP ICON "packaging/icons/app_icon.ico"

1 VERSIONINFO
 FILEVERSION 0,4,2,1
 PRODUCTVERSION 0,4,2,1
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "GitBoard"
      VALUE "FileDescription", "Barnaby Task Engine"
      VALUE "FileVersion", "0.4.2"
      VALUE "InternalName", "BarnabyWindows"
      VALUE "OriginalFilename", "Barnaby.exe"
      VALUE "ProductName", "Barnaby"
      VALUE "ProductVersion", "0.4.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
